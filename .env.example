# =============================================================================
# Mahadev Plastic - Environment Variables Configuration Template
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Nodemailer SMTP Configuration (Gmail)
# -----------------------------------------------------------------------------
# Host: smtp.gmail.com for Google Workspace or personal Gmail
SMTP_HOST=smtp.gmail.com
# Port: 587 (STARTTLS recommended) or 465 (SSL)
SMTP_PORT=587
# Secure: false for 587, true for 465
SMTP_SECURE=false

# Authenticated Google Account used to send emails
SMTP_USER=your_sending_email@gmail.com

# Google 16-character App Password (Generate at https://myaccount.google.com/apppasswords)
# Important: Do NOT use your regular Gmail password. 2-Step Verification must be enabled.
SMTP_PASS=xxxx xxxx xxxx xxxx

# Display name and email shown in the recipient's "From" field
SMTP_FROM="Mahadev Plastic" <your_sending_email@gmail.com>

# -----------------------------------------------------------------------------
# Form Submission Notification Recipients
# -----------------------------------------------------------------------------
# Email 1 goes to the customer automatically (the email they entered in the form)

# Email 2: Website Owner / Sales Desk
OWNER_EMAIL=mahadevplastic2019@gmail.com

# Email 3: Technical Partner / Maintenance Team
ADMIN_NOTIFY_EMAIL=integralwebsolution@gmail.com

# -----------------------------------------------------------------------------
# Blog Admin Backend Credentials
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Mahadev@2026!
ADMIN_JWT_SECRET=mahadev-plastic-super-secret-key-2026-secure-jwt

